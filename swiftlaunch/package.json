{
  "name": "swiftlaunch-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others -n \"shared,frontend,backend\" -c \"yellow,cyan,magenta\" \"pnpm --filter @swiftlaunch/shared dev\" \"pnpm --filter @swiftlaunch/frontend dev\" \"pnpm --filter @swiftlaunch/backend dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
